# Backend configuration for running on the HOST (make dev / make migrate).
# The container gets its configuration from docker-compose.yml instead.
#
# `make install` copies this file to .env for you.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vehicle_rental
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Object storage as reachable from the host.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vehicle-rental
MINIO_SECURE=false
MINIO_REGION=us-east-1