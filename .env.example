# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vehicle_rental
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/vehicle_rental

# Backend
# Override this in any shared environment.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Object storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=storage:9000
# Presigned URLs are opened by the browser, so they must be signed against an
# endpoint the browser can resolve — not the internal Docker hostname.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vehicle-rental
MINIO_SECURE=false
# Skips the S3 bucket-location lookup on every presign request.
MINIO_REGION=us-east-1

# Frontend
# In Docker, nginx proxies /api to the backend, so the default works.
# For `npm run dev` against a local API: http://localhost:8000/api/v1
VITE_API_URL=/api/v1
VITE_DEV_API_TARGET=http://localhost:8000